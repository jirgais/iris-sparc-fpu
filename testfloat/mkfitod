#
set -x
SEED1=5
SEED2=6
SEED3=7
SEED4=8
N=300000
LEVEL=1
TN=-tininessbefore
echo "F01 0    -- round to near" > tfitod_near.txt
echo "F02      -- testfloat exception bit order" >> tfitod_near.txt
testfloat_gen $TN -seed $SEED1 -level $LEVEL -rnear_even -n $N i32_to_f64 \
  | sed 's/^/0C8 /' | sort | uniq | shuf >> tfitod_near.txt
cp tfitod_near.txt tfitod.txt
echo "F01 1    -- round to zero" > tfitod_zero.txt
echo "F02      -- testfloat exception bit order" >> tfitod_zero.txt
testfloat_gen $TN -seed $SEED2 -level $LEVEL -rminMag -n $N i32_to_f64 \
  | sed 's/^/0C8 /' | sort | uniq | shuf >> tfitod_zero.txt
cat tfitod_zero.txt >> tfitod.txt
echo "F01 2    -- round to +inf" > tfitod_up.txt
echo "F02      -- testfloat exception bit order" >> tfitod_up.txt
testfloat_gen $TN -seed $SEED3 -level $LEVEL -rmax -n $N i32_to_f64 \
  | sed 's/^/0C8 /' | sort | uniq | shuf >> tfitod_up.txt
cat tfitod_up.txt >> tfitod.txt
echo "F01 3    -- round to -inf" > tfitod_down.txt
echo "F02      -- testfloat exception bit order" >> tfitod_down.txt
testfloat_gen $TN -seed $SEED4 -level $LEVEL -rmin -n $N i32_to_f64 \
  | sed 's/^/0C8 /' | sort | uniq | shuf >> tfitod_down.txt
cat tfitod_down.txt >> tfitod.txt
