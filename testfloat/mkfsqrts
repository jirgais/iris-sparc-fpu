#
set -x
SEED1=5
SEED2=6
SEED3=7
SEED4=8
N=200000
LEVEL=1
TN=-tininessbefore
echo "F01 0    -- round to near" > tfsqrts_near.txt
echo "F02      -- testfloat exception bit order" >> tfsqrts_near.txt
testfloat_gen $TN -seed $SEED1 -level $LEVEL -rnear_even -n $N f32_sqrt \
  | sed 's/^/029 /' | sort | uniq | shuf >> tfsqrts_near.txt
cp tfsqrts_near.txt tfsqrts.txt
echo "F01 1    -- round to zero" > tfsqrts_zero.txt
echo "F02      -- testfloat exception bit order" >> tfsqrts_zero.txt
testfloat_gen $TN -seed $SEED2 -level $LEVEL -rminMag -n $N f32_sqrt \
  | sed 's/^/029 /' | sort | uniq | shuf >> tfsqrts_zero.txt
cat tfsqrts_zero.txt >> tfsqrts.txt
echo "F01 2    -- round to +inf" > tfsqrts_up.txt
echo "F02      -- testfloat exception bit order" >> tfsqrts_up.txt
testfloat_gen $TN -seed $SEED3 -level $LEVEL -rmax -n $N f32_sqrt \
  | sed 's/^/029 /' | sort | uniq | shuf >> tfsqrts_up.txt
cat tfsqrts_up.txt >> tfsqrts.txt
echo "F01 3    -- round to -inf" > tfsqrts_down.txt
echo "F02      -- testfloat exception bit order" >> tfsqrts_down.txt
testfloat_gen $TN -seed $SEED4 -level $LEVEL -rmin -n $N f32_sqrt \
  | sed 's/^/029 /' | sort | uniq | shuf >> tfsqrts_down.txt
cat tfsqrts_down.txt >> tfsqrts.txt
