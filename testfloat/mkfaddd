#
set -x
SEED1=1
SEED2=2
SEED3=3
SEED4=4
N=200000
LEVEL=1
TN=-tininessbefore
echo "F01 0    -- round to near" > tfaddd_near.txt
echo "F02      -- testfloat exception bit order" >> tfaddd_near.txt
testfloat_gen $TN -seed $SEED1 -level $LEVEL -rnear_even -n $N f64_add \
  | sed 's/^/042 /' | sort | uniq | shuf >> tfaddd_near.txt
cp tfaddd_near.txt tfaddd.txt
echo "F01 1    -- round to zero" > tfaddd_zero.txt
echo "F02      -- testfloat exception bit order" >> tfaddd_zero.txt
testfloat_gen $TN -seed $SEED2 -level $LEVEL -rminMag -n $N f64_add \
  | sed 's/^/042 /' | sort | uniq | shuf >> tfaddd_zero.txt
cat tfaddd_zero.txt >> tfaddd.txt
echo "F01 2    -- round to +inf" > tfaddd_up.txt
echo "F02      -- testfloat exception bit order" >> tfaddd_up.txt
testfloat_gen $TN -seed $SEED3 -level $LEVEL -rmax -n $N f64_add \
  | sed 's/^/042 /' | sort | uniq | shuf >> tfaddd_up.txt
cat tfaddd_up.txt >> tfaddd.txt
echo "F01 3    -- round to -inf" > tfaddd_down.txt
echo "F02      -- testfloat exception bit order" >> tfaddd_down.txt
testfloat_gen $TN -seed $SEED4 -level $LEVEL -rmin -n $N f64_add \
  | sed 's/^/042 /' | sort | uniq | shuf >> tfaddd_down.txt
cat tfaddd_down.txt >> tfaddd.txt
