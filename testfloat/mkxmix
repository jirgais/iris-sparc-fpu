#
set -x
paste -d "\n" *_near*.txt *cmp*.txt > x
sort x | uniq > y
tail -n +2 y > x
echo "F01 0    -- round to near" > tfmix_near.txt
echo "F02      -- testfloat exception bit order" >> tfmix_near.txt
grep -v round x | grep -v testfloat | shuf >> tfmix_near.txt
